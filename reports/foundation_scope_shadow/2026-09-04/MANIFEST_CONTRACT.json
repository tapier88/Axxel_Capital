  "artifact": {
    "required": ["path", "sha256", "period", "fields", "kind"],
    "path_template": "data/engine/shadow/{certificate_id}/artifact.parquet",
    "kinds": ["dataset", "features", "labels", "cache", "experiences", "model"]
